RewriteEngine On

# =========================
# BACKEND
# =========================
RewriteRule ^backend(?:/(.*))?$ backend/web/$1 [L,QSA]

# =========================
# STORAGE
# =========================
RewriteRule ^storage(?:/(.*))?$ storage/web/$1 [L,QSA]

# =========================
# FRONTEND ROOT
# =========================
RewriteRule ^$ frontend/web/ [L,QSA]

# =========================
# FRONTEND DEFAULT
# =========================

# Jangan rewrite file/folder asli
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Jangan rewrite backend/storage
RewriteRule ^(backend|storage)(/|$) - [L]

# Semua selain backend/storage -> frontend
RewriteRule ^(.*)$ frontend/web/$1 [L,QSA]